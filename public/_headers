# Cloudflare Pages / Netlify header rules.
#
# Two jobs: cache aggressively where filenames are content-hashed, and set the
# security headers a site collecting personal data should have.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets never change under the same name — cache them for a year.
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are stable; cache hard. This is what keeps repeat visits
# on a metered mobile connection close to free.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

# HTML must revalidate so content edits appear immediately after a rebuild.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The CMS is not for visitors and must never be indexed.
/admin/*
  X-Robots-Tag: noindex, nofollow
