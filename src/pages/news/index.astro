---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const stories = (await getCollection("stories", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-CA", { day: "numeric", month: "long", year: "numeric" });
---

<Base
  title="News"
  description="Library openings, school visits and progress from The AVID Foundation's work in Lagos."
>
  <PageHeader
    eyebrow="News"
    title="What is actually happening."
    lead="Library openings, school visits, and the occasional honest note about something that took longer than we hoped."
  />

  <section class="section grain">
    <div class="shell">
      {
        stories.length > 0 ? (
          <ul class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {stories.map((story, i) => (
              <li class="reveal" data-reveal-delay={i * 70}>
                <article>
                  <a href={`/news/${story.id}`} class="group block">
                    {story.data.cover && (
                      <div class="mb-4 overflow-hidden rounded-sm border border-teal/15">
                        <Image
                          src={story.data.cover}
                          alt={story.data.coverAlt ?? ""}
                          widths={[420, 760]}
                          sizes="(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw"
                          class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <time class="card-field" datetime={story.data.date.toISOString()}>
                      {fmt(story.data.date)}
                    </time>
                    <h2 class="text-h3 mt-2 font-display group-hover:text-ochre-800">
                      {story.data.title}
                    </h2>
                    <p class="muted mt-2 text-small">{story.data.summary}</p>
                    <p class="mt-3 text-small font-semibold text-ochre-800 group-hover:underline">
                      Read on →
                    </p>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <div class="checkout-card mx-auto max-w-2xl p-8 pl-14">
            <span class="card-stamp inline-block">Nothing filed yet</span>
            <h2 class="text-h3 mt-6 font-display">
              We would rather post nothing than post filler.
            </h2>
            <p class="muted mt-4 text-small">
              This is where library openings and school visits will be recorded.
              The first entry will be written when the first library opens — not
              before. If you would like to know when that happens, the signup at
              the bottom of this page is the whole mailing list.
            </p>
            <p class="mt-5 text-small">
              <a class="link font-semibold" href="/our-work">
                See what we are building →
              </a>
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>
