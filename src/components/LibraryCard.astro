---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { COMPONENTS } from "../data/programme";

/**
 * One school on the transparency wall, drawn as a library checkout card.
 *
 * The brief calls the named-school wall "the single most persuasive thing a
 * small charity can do", so this card leads with the things that can be
 * checked: the school's name, where it is, how many pupils, and one specific
 * result. The sponsor credit and the date-due stamp column complete the motif.
 */
interface Props {
  entry: CollectionEntry<"libraries">;
  delay?: number;
}
const { entry, delay = 0 } = Astro.props;
const d = entry.data;

/* Utility classes win over the .tag component layer, so these override its
   default colours without needing an inline border reset — an earlier version
   used `style="border:0"` here, which left the pale "Committed" badge with no
   border and no contrast against the card. Each tone keeps a visible edge. */
const STATUS = {
  complete: { label: "Open", tone: "bg-ochre-700 text-paper border-ochre-700" },
  "in-progress": { label: "In progress", tone: "bg-teal text-paper border-teal" },
  committed: { label: "Committed", tone: "bg-cream text-ochre-800 border-teal/35" },
}[d.status];

const monthLabel = new Date(d.date + "-01").toLocaleDateString("en-CA", {
  month: "short",
  year: "numeric",
});
---

<li class="reveal" data-reveal-delay={delay}>
  <a
    href={`/our-work/${entry.id}`}
    class="checkout-card group block h-full transition-shadow hover:shadow-card"
  >
    {
      d.cover && (
        <div class="aspect-[4/3] overflow-hidden border-b border-teal/15 bg-teal/8">
          <Image
            src={d.cover}
            alt={d.coverAlt ?? `The library at ${d.school}, ${d.location}`}
            widths={[400, 700, 1000]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
          />
        </div>
      )
    }

    <div class="p-5 pl-11">
      <div class="flex items-start justify-between gap-3">
        <div>
          <span class="card-field">School</span>
          <h3 class="text-h4 font-display leading-tight">{d.school}</h3>
        </div>
        <span class={`tag flex-none ${STATUS.tone}`}>{STATUS.label}</span>
      </div>

      <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3">
        <div>
          <dt class="card-field">Location</dt>
          <dd class="text-small font-semibold">{d.location}</dd>
        </div>
        <div>
          <dt class="card-field">Pupils</dt>
          <dd class="nums text-small font-semibold">{d.pupils.toLocaleString("en-CA")}</dd>
        </div>
        <div>
          <dt class="card-field">Books placed</dt>
          <dd class="nums text-small font-semibold">
            {d.booksPlaced > 0 ? d.booksPlaced.toLocaleString("en-CA") : "—"}
          </dd>
        </div>
        <div>
          <dt class="card-field">
            {d.status === "complete" ? "Opened" : "Due"}
          </dt>
          <dd class="nums text-small font-semibold">{monthLabel}</dd>
        </div>
      </dl>

      <p class="mt-4 border-t border-teal/12 pt-3 text-small">{d.result}</p>

      {/* Which of the five components this project included — shown as five
          slots so an incomplete package is visible rather than hidden. */}
      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Package components included">
        {
          COMPONENTS.map((c) => {
            const has = d.components.includes(c.key);
            return (
              <li
                class:list={[
                  "font-card text-tag rounded-sm px-1.5 py-0.5",
                  has
                    ? "bg-ochre-500/18 text-ochre-800"
                    : "bg-teal/8 text-ink/40 line-through",
                ]}
                title={has ? `${c.name} — included` : `${c.name} — not part of this project`}
              >
                {c.name.replace("The ", "")}
              </li>
            );
          })
        }
      </ul>

      {
        d.sponsor && (
          <p class="card-field mt-4 flex items-center gap-2 border-t border-teal/12 pt-3">
            <span>Sponsored by</span>
            <span class="text-ink normal-case">{d.sponsor}</span>
          </p>
        )
      }

      <p class="mt-4 text-small font-semibold text-ochre-800 group-hover:underline">
        Read the record →
        <span class="sr-only-text">for {d.school}</span>
      </p>
    </div>
  </a>
</li>
