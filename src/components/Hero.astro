---
import BookWall from "./BookWall.astro";
import ClassroomScene from "./ClassroomScene.astro";
import DonateButton from "./DonateButton.astro";

/**
 * ── THE SIGNATURE MOMENT ────────────────────────────────────────────────────
 *
 * The brief asks for the vision line — "where every classroom has a library
 * behind it" — carried into the design as one memorable treatment, used once.
 *
 * This is it. Two layers: a wall of shelves at the back, a classroom in front.
 * As the reader scrolls, the classroom travels down and out of frame while the
 * shelves hold position and brighten, so the library is revealed behind the
 * classroom. The vision line is not described; it happens.
 *
 * Built on CSS scroll-driven animation (`animation-timeline: scroll()`), which
 * runs off the main thread — so it stays smooth on a mid-range Android phone,
 * which a JavaScript scroll handler would not. Where the feature is
 * unsupported, or the reader prefers reduced motion, the layers simply render
 * in their composed resting state: both visible, nothing broken, no fallback
 * that looks like a mistake.
 * ─────────────────────────────────────────────────────────────────────────── */
---

<section class="hero on-dark relative isolate overflow-hidden bg-teal" aria-labelledby="hero-heading">
  <!-- Layer 1 (back): the library -->
  <div class="hero-shelves pointer-events-none absolute inset-x-0 bottom-0 h-[70%] sm:h-[66%]">
    <BookWall shelves={4} class="h-full w-full" />
  </div>

  <!-- Layer 2 (front): the classroom -->
  <div class="hero-classroom pointer-events-none absolute inset-x-0 bottom-0 h-[52%] sm:h-[50%]">
    <ClassroomScene class="h-full w-full" />
  </div>

  <!--
    Layer 3: one scrim over BOTH art layers, not underneath either.
    Solid at the top so the headline sits on flat colour and always clears AA,
    clearing to nothing at the base so the shelves and desks keep their detail.
  -->
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-teal from-22% via-teal/88 via-60% to-transparent"
    aria-hidden="true"
  >
  </div>

  <!-- Layer 3: the words -->
  <div class="shell relative z-10 flex min-h-[clamp(34rem,88svh,52rem)] flex-col justify-center py-24">
    <div class="max-w-3xl">
      <p class="eyebrow">
        <span>A Canadian non-profit · Beginning in Lagos</span>
      </p>

      <h1 id="hero-heading" class="text-hero mt-6 font-display">
        Where every classroom has a&nbsp;library behind it.
      </h1>

      <p class="mt-7 max-w-2xl text-lead text-paper/90">
        The AVID Foundation refurbishes and restocks libraries in
        under-resourced Nigerian schools — and supports the teachers who bring
        them to life. We begin in Lagos.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <DonateButton label="Sponsor a library" variant="on-dark" />
        <a href="#how-it-works" class="btn btn-ghost-dark">See how it works</a>
      </div>

      <!-- The two audience paths, unmistakable from the first screen. -->
      <p class="mt-10 text-small text-paper/75">
        Are you a school leader in Lagos?{" "}
        <a class="link font-semibold" href="/for-schools">Apply for a library →</a>
      </p>
    </div>
  </div>

  <!-- Scroll cue. Hidden once the reader has started, and from anyone who has
       asked for reduced motion. -->
  <div
    class="hero-cue pointer-events-none absolute bottom-5 left-1/2 z-10 -translate-x-1/2"
    aria-hidden="true"
  >
    <span class="card-field text-paper/55">Scroll</span>
  </div>
</section>

<style>
  /* Resting composition — what everyone sees before any scrolling, and what
     readers on browsers without scroll-driven animation see permanently.
     Both layers are already in frame and legible: this state is a design, not
     a degradation. */
  .hero-shelves {
    opacity: 0.85;
    translate: 0 0;
  }
  .hero-classroom {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      /* The reveal is driven by the document's own scroll position over the
         first screenful, so it is complete by the time the next section
         arrives. `both` fill keeps the end state after the range. */
      .hero-shelves {
        animation: shelves-rise linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 90vh;
      }
      .hero-classroom {
        animation: classroom-exit linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 90vh;
      }
      .hero-cue {
        animation: cue-fade linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 18vh;
      }

      @keyframes shelves-rise {
        /* Starts a touch low and dim, settles into place and brightens: the
           shelves come forward as the classroom clears. */
        from {
          translate: 0 4%;
          opacity: 0.7;
        }
        to {
          translate: 0 -2%;
          opacity: 1;
        }
      }

      @keyframes classroom-exit {
        from {
          translate: 0 0;
          opacity: 1;
        }
        60% {
          opacity: 0.85;
        }
        to {
          translate: 0 42%;
          opacity: 0;
        }
      }

      @keyframes cue-fade {
        from { opacity: 1; }
        to { opacity: 0; }
      }
    }
  }
</style>
