---
import { SITE, ANALYTICS, SEARCH } from "../data/site";
import { IS_PRODUCTION } from "../lib/env";

interface Props {
  title: string;
  description: string;
  /** Path to a share image in /public. Falls back to the site card. */
  image?: string;
  /** Set on story pages so search engines and social cards show a date. */
  publishedOn?: Date;
  /** Set true on pages that should not be indexed (e.g. thank-you pages). */
  noindex?: boolean;
  /** Structured data for this specific page, merged after the org graph. */
  extraJsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image = "/og-default.png",
  publishedOn,
  noindex = false,
  extraJsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", SITE.url);
const ogImage = new URL(image, SITE.url);

/* Every page carries the same brand suffix except the home page.
   The home title pairs the name with what AVID does rather than the tagline:
   the tagline is 46 characters and pushed the title to 68, well past the ~60
   Google shows, so the distinctive half was the half being cut. It still leads
   the page as the h1, where it has room. */
const fullTitle =
  Astro.url.pathname === "/"
    ? `${SITE.name} — School Libraries in Nigeria`
    : `${title} · ${SITE.name}`;

/* Structured data. Declaring the organisation on every page lets Google
   associate the pages, the logo and the registration details with one entity —
   which is exactly what a funder searching for AVID should find. */
const orgJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: SITE.name,
  alternateName: SITE.shortName,
  url: SITE.url,
  logo: new URL("/logo-mark.svg", SITE.url).href,
  image: ogImage.href,
  slogan: SITE.tagline,
  description: SITE.blurb,
  foundingDate: SITE.founded,
  email: SITE.email.general,
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.location.city,
    addressRegion: SITE.location.region,
    addressCountry: "CA",
  },
  areaServed: [
    { "@type": "Country", name: "Nigeria" },
    { "@type": "AdministrativeArea", name: "Lagos State" },
  ],
  knowsAbout: [
    "School libraries",
    "Childhood literacy",
    "Library refurbishment",
    "Education in Nigeria",
    "Education in Lagos",
    "Nigerian and African children's literature",
  ],
  foundingLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: SITE.location.city,
      addressRegion: SITE.location.region,
      addressCountry: "CA",
    },
  },
  /* Separate contact points, so a search engine can surface the right one and
     a school is not routed to the partnerships inbox. */
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "general enquiries",
      email: SITE.email.general,
      areaServed: ["CA", "NG"],
      availableLanguage: ["English"],
    },
    {
      "@type": "ContactPoint",
      contactType: "school applications",
      email: SITE.email.applications,
      areaServed: "NG",
      availableLanguage: ["English"],
    },
    {
      "@type": "ContactPoint",
      contactType: "partnerships and grants",
      email: SITE.email.partnerships,
      areaServed: ["CA", "NG"],
      availableLanguage: ["English"],
    },
  ],
  ...(SITE.charitableRegistrationNumber
    ? {
        identifier: {
          "@type": "PropertyValue",
          name: "CRA charitable registration number",
          value: SITE.charitableRegistrationNumber,
        },
      }
    : {}),
  ...(Object.values(SITE.social).filter(Boolean).length
    ? { sameAs: Object.values(SITE.social).filter(Boolean) }
    : {}),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  inLanguage: "en-CA",
  publisher: { "@type": "NGO", name: SITE.name, url: SITE.url },
};

/* Breadcrumbs, derived from the URL. Google shows these in place of the raw
   path in a result, which reads far better than a bare URL. */
const segments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbJsonLd =
  segments.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
          ...segments.map((seg, i) => ({
            "@type": "ListItem",
            position: i + 2,
            name:
              i === segments.length - 1
                ? title
                : seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
            item: `${SITE.url}/${segments.slice(0, i + 1).join("/")}`,
          })),
        ],
      }
    : null;

const jsonLdBlocks = [
  orgJsonLd,
  websiteJsonLd,
  ...(breadcrumbJsonLd && !noindex ? [breadcrumbJsonLd] : []),
  ...(extraJsonLd ? [extraJsonLd] : []),
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{/* Per-page opt-out, plus a blanket block on any non-production build so a
    preview URL can never be indexed alongside the real domain. */}
{noindex && IS_PRODUCTION && <meta name="robots" content="noindex, follow" />}
{!IS_PRODUCTION && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={publishedOn ? "article" : "website"} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
<meta property="og:locale" content="en_CA" />
{publishedOn && (
  <meta property="article:published_time" content={publishedOn.toISOString()} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />

{SEARCH.googleSiteVerification && (
  <meta name="google-site-verification" content={SEARCH.googleSiteVerification} />
)}
{SEARCH.bingSiteVerification && (
  <meta name="msvalidate.01" content={SEARCH.bingSiteVerification} />
)}

<meta name="theme-color" content="#133B42" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Preload only the two faces used above the fold. The rest load on demand
     via unicode-range, so a reader on mobile data fetches the minimum. -->
<link
  rel="preload"
  href="/fonts/fraunces-var-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/publicsans-var-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — News`} href="/rss.xml" />

{jsonLdBlocks.map((block) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
))}

{/* Cookieless analytics. Loads nothing and sets nothing unless configured. */}
{ANALYTICS.plausibleDomain && (
  <script
    is:inline
    defer
    data-domain={ANALYTICS.plausibleDomain}
    src="https://plausible.io/js/script.outbound-links.js"
  />
)}
